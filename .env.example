# Copy to .env.local and fill in. All values are NEXT_PUBLIC_* — this site holds NO secrets.

# Solana network: devnet | mainnet-beta | testnet
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Optional dedicated RPC endpoint (Helius/QuickNode/Alchemy). Blank = public cluster URL.
NEXT_PUBLIC_SOLANA_RPC=

# The $PULSE mint address. Blank shows a "Launching soon" state instead of the address.
NEXT_PUBLIC_TOKEN_MINT=
NEXT_PUBLIC_TOKEN_SYMBOL=PULSE
NEXT_PUBLIC_TOKEN_DECIMALS=9

# ----------------------------------------------------------------------------
# Multi-network ecosystem (Devnet / Testnet / Mainnet) — OPTIONAL public RPC
# overrides used by config/networks.js. Blank = the public cluster URL below.
# These are PUBLIC endpoints only. NEVER put an RPC that embeds an API key or
# any secret here — this file ships to the browser. Use a proxy for private RPC.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_DEVNET_RPC=
NEXT_PUBLIC_TESTNET_RPC=
NEXT_PUBLIC_MAINNET_RPC=

# ============================================================================
# SERVER-ONLY faucet secrets — read ONLY by app/api/faucet/route.js on the
# server. NEVER prefix any of these with NEXT_PUBLIC_, and NEVER commit a real
# value (this .env.example ships blank on purpose; put real values in
# .env.local locally, and in Vercel → Settings → Environment Variables).
# ----------------------------------------------------------------------------
# Treasury wallet secret key as a JSON byte array — the exact contents of a
#   solana-keygen new --no-bip39-passphrase -o faucet.json
# file, e.g. [12,34,56,...] (64 numbers). Generate a NEW, low-value throwaway
# wallet for this — do NOT reuse your token mint-authority key. Fund it with
# test SOL on FAUCET_CLUSTER below. Claude never generates or touches this key.
FAUCET_SECRET_KEY=
# Which cluster the treasury serves + funds from: testnet | devnet. Default testnet.
FAUCET_CLUSTER=testnet
# SOL sent per claim (small, so the treasury lasts). Default 0.1.
FAUCET_AMOUNT_SOL=0.1
# Optional dedicated server RPC. Unlike the NEXT_PUBLIC_* ones above, this stays
# server-side, so it MAY embed a provider API key. Blank = public cluster URL.
FAUCET_RPC=
# Optional: durable per-wallet + per-IP 24h rate limit via Vercel KV / Upstash
# Redis REST. Without both, rate limiting is best-effort (client guard +
# per-server memory + small amount + finite treasury). Set both to make the
# 1-claim-per-wallet-per-24h limit enforced across the whole fleet.
KV_REST_API_URL=
KV_REST_API_TOKEN=
